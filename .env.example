# CampusNotify Environment Variables
# Copy this file to .env and fill in your values

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_CONFIG=development

# Database
# MySQL:  mysql+pymysql://user:password@localhost/campus_notify
# SQLite: sqlite:///campus_notify.db  (default — great for getting started)
DATABASE_URL=sqlite:///campus_notify.db

# Messaging Mode: 'demo' (default) or 'twilio'
# Demo mode simulates SMS — no real messages are sent.
# Set to 'twilio' only after configuring the variables below.
MESSAGING_MODE=demo

# Twilio Credentials (only needed when MESSAGING_MODE=twilio)
# Find these at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
