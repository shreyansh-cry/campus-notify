# ── Environment & secrets ────────────────────────────────────────────────────
# Never commit real credentials. Use .env.example as a template.
.env
*.env
!.env.example

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Python caches ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Databases & dumps ─────────────────────────────────────────────────────────
# Local SQLite databases contain real subscriber records — exclude all of them.
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# Flask instance folder (holds the local DB and any instance-level config)
instance/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Test & coverage artifacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ── Distribution / packaging ──────────────────────────────────────────────────
*.tar.gz
*.whl
*.zip

# ── IDE & editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Operating system ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

